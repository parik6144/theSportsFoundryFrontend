# Copy to Vercel → Project → Settings → Environment Variables → Import .env
# No MySQL needed for public enquiry forms (email only).

SITE_URL=https://YOUR-PROJECT.vercel.app
ENQUIRY_TO_EMAIL=info@sportsfoundry.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@sportsfoundry.in
SMTP_PASS=your-google-app-password-here
SMTP_FROM=The Sports Foundry <info@sportsfoundry.in>
