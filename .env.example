# Public site (Vercel) — email only, no database required for enquiry forms.
# Do NOT set DATABASE_URL on Vercel unless MySQL is publicly reachable from Vercel.
# Admin CRUD (Athletes/Teams/Academies/Brands) belongs on EC2 with local MySQL.

SITE_URL="http://localhost:3001"
ENQUIRY_TO_EMAIL="info@sportsfoundry.in"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@sportsfoundry.in"
SMTP_PASS=""
SMTP_FROM="The Sports Foundry <info@sportsfoundry.in>"

# EC2 admin only — prefer 127.0.0.1 on the server, not the public IP:
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/db_thesportsfoundry"
