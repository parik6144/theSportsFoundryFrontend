# Public site on Vercel — form enquiries + admin CRUD use JSON store (no MySQL).
# On Vercel (VERCEL=1), JSON is always used unless DATA_STORE=mysql.
# Local: writes to data/*.json
# Production persistence: set BLOB_READ_WRITE_TOKEN (Vercel → Storage → Blob)

SITE_URL="http://localhost:3001"
ENQUIRY_TO_EMAIL="info@sportsfoundry.in"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@sportsfoundry.in"
SMTP_PASS=""
SMTP_FROM="The Sports Foundry <info@sportsfoundry.in>"

# DATA_STORE="json"
# BLOB_READ_WRITE_TOKEN=""

# Do not set DATABASE_URL on Vercel (stale MySQL causes 503s). Optional local only:
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/db_thesportsfoundry"
# DATA_STORE="mysql"
