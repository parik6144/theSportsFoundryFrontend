# MySQL — local XAMPP example:
# DATABASE_URL="mysql://root@127.0.0.1:3306/db_thesportsfoundry"
#
# Vercel → EC2 MySQL (remote; open port 3306 + allow Vercel IPs in security group):
# DATABASE_URL="mysql://sportsphere:SportSphere%402026@13.50.4.113:3306/db_thesportsfoundry"
DATABASE_URL="mysql://root@127.0.0.1:3306/db_thesportsfoundry"

# Public site URL (used in emails)
SITE_URL="http://localhost:3001"

# Enquiry emails → info@sportsfoundry.in
ENQUIRY_TO_EMAIL="info@sportsfoundry.in"

# Google Workspace SMTP for info@sportsfoundry.in (use App Password, not normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@sportsfoundry.in"
SMTP_PASS=""
SMTP_FROM="The Sports Foundry <info@sportsfoundry.in>"
