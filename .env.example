# Public site on Vercel — form enquiries + admin CRUD use JSON store (no MySQL).
# Local: writes to data/*.json
# Production: set BLOB_READ_WRITE_TOKEN (Vercel → Storage → Blob)

SITE_URL="http://localhost:3001"
ENQUIRY_TO_EMAIL="info@sportsfoundry.in"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@sportsfoundry.in"
SMTP_PASS=""
SMTP_FROM="The Sports Foundry <info@sportsfoundry.in>"

# Force JSON store (default when DATABASE_URL is unset):
# DATA_STORE="json"

# Vercel Blob — required for persistent CRUD on Vercel:
# BLOB_READ_WRITE_TOKEN=""

# Optional legacy MySQL (not used on Vercel-only setup):
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/db_thesportsfoundry"
# DATA_STORE="mysql"
